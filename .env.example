# =============================================================================
# NPS Insight Engine — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# For Dev Container users, copy from .devcontainer/.env.local instead:
#   cp .devcontainer/.env.local .env.local
#
# NOTE: Next.js auto-loads .env.local for `npm run dev` and `npm run build`.
#       The `npm run db:init` script loads it via dotenv.
# =============================================================================

# -- SQL Server Connection ----------------------------------------------------
# For local Docker: host=localhost
# For Dev Container: host=sqlserver (the Docker service name)
DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_USER=sa
DATABASE_PASSWORD=           # Set to match your docker-compose MSSQL_SA_PASSWORD (default: NpsEngine@2025)
DATABASE_NAME=nps_insight_engine

# -- API Key Encryption -------------------------------------------------------
# 64-character hex string used for AES-256-GCM encryption of LLM API keys.
# Generate a secure key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=              # REQUIRED — generate with the command above

# -- Authentication -----------------------------------------------------------
# Set to "false" to disable auth for local development (default: true)
AUTH_REQUIRED=false

# -- Node Environment ---------------------------------------------------------
# Set to "production" to disable TypeORM synchronize and verbose logging
NODE_ENV=development
