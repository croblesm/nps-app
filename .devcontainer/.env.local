# =============================================================================
# NPS Insight Engine — Dev Container Environment Variables
# =============================================================================
# Copy this file to .env.local at the project root:
#   cp .devcontainer/.env.local .env.local
# =============================================================================

# -- SQL Server Connection ----------------------------------------------------
# In Dev Container, the host is the Docker service name (not localhost)
DATABASE_HOST=sqlserver
DATABASE_PORT=1433
DATABASE_USER=sa
DATABASE_PASSWORD=NpsEngine@2025
DATABASE_NAME=nps_insight_engine

# -- API Key Encryption -------------------------------------------------------
# 64-character hex string used for AES-256-GCM encryption of LLM API keys.
# Generate a secure key for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -- Node Environment ---------------------------------------------------------
NODE_ENV=development
